{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["bun", "node"],
		"strict": true,
		"jsx": "preserve",
		"jsxImportSource": "@opentui/solid",
		"declaration": true,
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"skipLibCheck": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
